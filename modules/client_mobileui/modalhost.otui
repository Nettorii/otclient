MobileModalButton < MobileOverlayQtButton
  height: 48
  min-width: 48
  font: verdana-11px-antialised
  mobile-overlay-base: #101c29

MobileModalBackdrop < MobileOverlayPanel
  anchors.fill: parent
  background-color: #02060acc
  mobile-overlay-base: #02060a
  focusable: true
  phantom: false

  MobileUISurface
    id: modalSurface
    background-color: #0b131eee
    mobile-overlay-base: #0b131e
    border-width: 1
    border-color: #7891a477
    clipping: true

    MobileOverlayPanel
      id: modalHeader
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      height: 48
      background-color: #152333ee
      mobile-overlay-base: #152333
      border-width-bottom: 1
      border-color-bottom: #7891a466

      Label
        id: modalTitle
        anchors.fill: parent
        margin-left: 14
        margin-right: 14
        color: #e5edf4
        font: verdana-11px-antialised
        text-align: left
        text-wrap: true

    UIScrollArea
      id: modalBody
      anchors.left: parent.left
      anchors.right: modalBodyScrollBar.left
      anchors.top: modalHeader.bottom
      anchors.bottom: modalFooter.top
      margin: 8
      margin-right: 4
      vertical-scrollbar: modalBodyScrollBar
      clipping: true
      layout:
        type: verticalBox
        spacing: 6

    VerticalScrollBar
      id: modalBodyScrollBar
      anchors.top: modalHeader.bottom
      anchors.bottom: modalFooter.top
      anchors.right: parent.right
      margin-top: 8
      margin-right: 6
      margin-bottom: 8
      step: 48
      pixels-scroll: true

    MobileOverlayScrollArea
      id: modalFooter
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      height: 48
      padding-left: 8
      padding-right: 8
      background-color: #101c29ee
      mobile-overlay-base: #101c29
      border-width-top: 1
      border-color-top: #7891a455
      clipping: true
      horizontal-scrollbar: modalFooterScrollBar
      layout:
        type: horizontalBox
        spacing: 8

    HorizontalScrollBar
      id: modalFooterScrollBar
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      height: 0
      visible: false
      step: 48
      pixels-scroll: true
