MobileDrawerMinimap < Minimap
  anchors.fill: parent
  draggable: true
  focusable: false
  phantom: false

MobileMinimapButton < MobileOverlayButton
  min-width: 48
  height: 48
  background-color: #101c29ee
  mobile-overlay-base: #101c29
  border-width: 1
  border-color: #7891a455
  color: #dbe6ee
  font: verdana-11px-antialised
  text-align: center
  focusable: false
  phantom: false

  $hover:
    border-color: #8fa9ba88

  $pressed:
    border-color: #9fc0d699

MobileMinimapView < Panel
  height: 324
  anchors.left: parent.left
  anchors.right: parent.right
  focusable: false
  phantom: false
  layout:
    type: verticalBox
    spacing: 6

  Panel
    id: mobileMinimapHost
    height: 222
    background-color: #05090d
    border-width: 1
    border-color: #7891a466
    clipping: true
    phantom: false

  Panel
    id: minimapControls
    height: 96
    phantom: false

    MobileMinimapButton
      id: minimapZoomOut
      text: -

    MobileMinimapButton
      id: minimapCenter
      text: Center

    MobileMinimapButton
      id: minimapZoomIn
      text: +

    MobileMinimapButton
      id: minimapFloorUp
      text: Up

    Label
      id: minimapFloorValue
      min-width: 48
      height: 48
      color: #dbe6ee
      font: verdana-11px-antialised
      text-align: center
      phantom: true

    MobileMinimapButton
      id: minimapFloorDown
      text: Down
