Module
  name: game_mobileui
  description: Responsive mobile UI v2 gameplay shell
  author: OTClient team
  website: https://github.com/mehah/otclient
  sandboxed: true
  scripts: [ status, actions, hotbar, drawer, views/inventory, views/character, views/minimap, game_mobileui ]
  dependencies: [ client_mobileui, game_interface, game_actionbar, game_inventory, game_containers, game_skills, game_minimap ]
  @onLoad: init()
  @onUnload: terminate()
