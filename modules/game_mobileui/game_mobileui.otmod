Module
  name: game_mobileui
  description: Responsive mobile UI v2 gameplay shell
  author: OTClient team
  website: https://github.com/mehah/otclient
  sandboxed: true
  scripts: [ status, actions, hotbar, drawer, chat, reconnecting, views/inventory, views/character, views/minimap, views/battle, views/vip, views/settings, game_mobileui ]
  dependencies: [ client_mobileui, client_entergame, client_options, game_interface, game_console, game_actionbar, game_inventory, game_containers, game_skills, game_minimap, game_battle, game_viplist ]
  @onLoad: init()
  @onUnload: terminate()
