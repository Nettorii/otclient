MobileHudSurface < MobileOverlayPanel
  background-color: #08121dcc
  mobile-overlay-base: #08121d
  border-width: 1
  border-color: #7891a455
  focusable: false

MobileHudTarget < MobileOverlayButton
  size: 48 48
  background-color: #0b1623dd
  mobile-overlay-base: #0b1623
  border-width: 1
  border-color: #7891a466
  color: #e5edf4
  font: verdana-11px-antialised
  text-align: center
  focusable: false
  phantom: false
  $hover:
    border-color: #8fa9ba88
  $pressed:
    border-color: #9fc0d699

MobileHotbarSlot < MobileHudTarget
  background-color: #0a1420d9
  mobile-overlay-base: #0a1420
  color: #aebdca
  font: verdana-11px-rounded
  image-source: /images/game/actionbar/actionbarslot
  image-border: 2
  opacity: 0.9

  Item
    id: item
    anchors.fill: parent
    margin: 3
    virtual: true
    phantom: true
    always-show-count: true
    font: verdana-8px-rounded

  Label
    id: text
    anchors.fill: parent
    margin: 3
    text-wrap: true
    text-align: center
    font: small-9px
    phantom: true
    image-fixed-ratio: true

  UIProgressRect
    id: cooldown
    anchors.fill: parent
    background: #101010aa
    percent: 100
    focusable: false
    phantom: true
    font: verdana-11px-rounded
    color: white
    visible: false

MobileHudStatusBar < MobileOverlayProgressBar
  height: 13
  background-color: #02060acc
  mobile-overlay-base: #02060a
  border-width: 1
  border-color: #7891a444
  phantom: true
