MobileDrawerNavigationButton < MobileOverlayButton
  width: 72
  height: 48
  min-width: 48
  background-color: #101c29ee
  mobile-overlay-base: #101c29
  border-width: 1
  border-color: #7891a455
  color: #dbe6ee
  font: verdana-11px-antialised
  text-align: center
  focusable: false
  phantom: false
  $hover:
    border-color: #8fa9ba88
  $pressed:
    border-color: #9fc0d699
  $disabled:
    border-color: #9fc0d699
    color: #ffffff

MobileDrawerCloseButton < MobileOverlayButton
  size: 48 48
  background-color: #101c29ee
  mobile-overlay-base: #101c29
  border-width: 1
  border-color: #7891a455
  color: #dbe6ee
  font: verdana-11px-antialised
  text: X
  text-align: center
  focusable: false
  phantom: false
  $hover:
    border-color: #8fa9ba88
  $pressed:
    border-color: #9fc0d699

MobileDrawerViewHost < Panel
  min-height: 1
  focusable: false
  phantom: false

MobileDrawerBackdrop < MobileOverlayPanel
  id: drawerBackdrop
  anchors.fill: parent
  background-color: #02060aaa
  mobile-overlay-base: #02060a
  focusable: true
  phantom: false

  MobileOverlayPanel
    id: drawerSurface
    background-color: #0b131ef5
    mobile-overlay-base: #0b131e
    border-width: 1
    border-color: #7891a477
    clipping: true
    focusable: false
    phantom: false

    MobileOverlayPanel
      id: drawerHeader
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      height: 48
      background-color: #152333f5
      mobile-overlay-base: #152333
      border-width-bottom: 1
      border-color-bottom: #7891a466
      phantom: false

      MobileDrawerCloseButton
        id: drawerClose
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter

      Label
        id: drawerTitle
        anchors.left: parent.left
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.right: drawerClose.left
        margin-left: 14
        margin-right: 8
        color: #e5edf4
        font: verdana-11px-antialised
        text-align: left
        text-wrap: true
        phantom: true

    UIScrollArea
      id: drawerContent
      anchors.left: parent.left
      anchors.right: drawerContentScrollBar.left
      anchors.top: drawerHeader.bottom
      anchors.bottom: drawerNavigation.top
      margin: 8
      margin-right: 4
      vertical-scrollbar: drawerContentScrollBar
      clipping: true
      phantom: false
      layout:
        type: verticalBox
        spacing: 6

    VerticalScrollBar
      id: drawerContentScrollBar
      anchors.top: drawerHeader.bottom
      anchors.bottom: drawerNavigation.top
      anchors.right: parent.right
      margin-top: 8
      margin-right: 4
      margin-bottom: 8
      step: 48
      pixels-scroll: true

    MobileOverlayScrollArea
      id: drawerNavigation
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      height: 48
      padding-left: 4
      padding-right: 4
      background-color: #101c29f5
      mobile-overlay-base: #101c29
      border-width-top: 1
      border-color-top: #7891a455
      horizontal-scrollbar: drawerNavigationScrollBar
      clipping: true
      phantom: false
      layout:
        type: horizontalBox
        spacing: 4

    HorizontalScrollBar
      id: drawerNavigationScrollBar
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      height: 0
      visible: false
      step: 48
      pixels-scroll: true
