UIWidget
  id: mobileHud
  anchors.fill: parent
  focusable: false
  phantom: true
  visible: false

  MobileHudSurface
    id: status
    phantom: true

    Label
      id: statusName
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 8
      margin-top: 2
      width: 78
      text: STATUS
      color: #d7e2eb
      font: verdana-8px-rounded
      text-align: left
      phantom: true

    Label
      id: level
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 2
      width: 30
      color: #b9c9d5
      font: verdana-8px-rounded
      text-align: left
      phantom: true

    Label
      id: vocation
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 2
      width: 72
      color: #b9c9d5
      font: verdana-8px-rounded
      text-align: right
      phantom: true

    Label
      id: stamina
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 2
      width: 48
      color: #b9c9d5
      font: verdana-8px-rounded
      text-align: left
      phantom: true
      visible: false

    MobileHudStatusBar
      id: health
      anchors.left: parent.left
      anchors.right: soul.left
      anchors.top: parent.top
      margin-left: 8
      margin-right: 4
      margin-top: 16
      percent: 100
      background-color: #641f29dd
      mobile-overlay-base: #641f29

    Label
      id: healthValue
      anchors.fill: health
      color: #f0d9dd
      font: verdana-8px-rounded
      text-align: center
      phantom: true

    Label
      id: soul
      width: 43
      height: 13
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 16
      margin-right: 5
      color: #d9c3e9
      font: verdana-8px-rounded
      text-align: right
      phantom: true
      visible: false

    MobileHudStatusBar
      id: mana
      anchors.left: parent.left
      anchors.right: capacity.left
      anchors.bottom: parent.bottom
      margin-left: 8
      margin-right: 4
      margin-bottom: 3
      percent: 100
      background-color: #245477dd
      mobile-overlay-base: #245477

    Label
      id: manaValue
      anchors.fill: mana
      color: #d8e7f2
      font: verdana-8px-rounded
      text-align: center
      phantom: true

    Label
      id: capacity
      width: 43
      height: 13
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-right: 5
      margin-bottom: 3
      color: #d7d9c3
      font: verdana-8px-rounded
      text-align: right
      phantom: true
      visible: false

  MobileHudTarget
    id: menu
    text: MENU

  UIWidget
    id: joystickHost
    focusable: false
    phantom: true

  UIWidget
    id: hotbar
    focusable: false
    phantom: false

  UIWidget
    id: actions
    focusable: false
    phantom: true

    MobileHudTarget
      id: attack
      text: ATK

    MobileHudTarget
      id: use
      text: USE

    MobileHudTarget
      id: chat
      text: CHAT

    MobileHudTarget
      id: inventory
      text: BAG

  MobileHudTarget
    id: drawerHandle
    text: >

  MobileHudTarget
    id: zoomOut
    text: -
    font: terminus-14px-bold

  MobileHudTarget
    id: zoomIn
    text: +
    font: terminus-14px-bold
